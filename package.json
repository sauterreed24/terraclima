{
  "name": "terraclima",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Terraclima — North American Microclimate Atlas. A research-grade microclimate intelligence app for scouting relocation, travel, and hidden gems across the USA, Mexico, and Canada.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "build:pages": "cross-env VITE_BASE_PATH=/terraclima/ npm run build",
    "build:static": "cross-env VITE_BASE_PATH=./ npm run build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "test:prose": "tsx scripts/test-prose.ts",
    "test:celsius": "tsx scripts/playtest-celsius.ts",
    "playtest:polish": "tsx scripts/playtest-polish.ts",
    "playtest:map": "node scripts/playtest-map.mjs",
    "playtest:browser": "node scripts/playtest-browser.mjs",
    "test:browser": "node scripts/playtest-browser.mjs",
    "check:metadata": "tsx scripts/check-site-metadata.ts",
    "check:performance-budget": "tsx scripts/check-performance-budget.ts",
    "audit:corpus": "tsx scripts/audit-corpus.ts",
    "sanity": "tsx scripts/sanity-check.ts",
    "corpus:coverage": "tsx scripts/corpus-coverage-report.ts",
    "test:corpus-gold": "tsx scripts/corpus-rank-gold.ts",
    "dump:corpus-rank": "tsx scripts/dump-corpus-ranks.ts",
    "generate:og": "tsx scripts/generate-og-image.ts",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "quality:check": "npm run typecheck && npm run lint && npm run test && npm run test:prose && npm run test:celsius && npm run playtest:polish && npm run check:metadata && npm run audit:corpus && npm run sanity && npm run corpus:coverage && npm run test:corpus-gold && npm run climate:data:verify && npm run corpus:research:verify && npm run corpus:voice:check && npm run corpus:consistency:check && npm run build && npm run check:performance-budget",
    "playtest:hero-media": "tsx scripts/check-place-hero-files.ts",
    "playtest:rigorous": "tsx scripts/check-place-hero-files.ts && node scripts/playtest-rigorous.mjs",
    "playtest:climate-v2": "node scripts/playtest-climate-v2-regressions.mjs",
    "playtest:release-audit": "node scripts/playtest-release-audit.mjs",
    "climate:data:fetch": "tsx scripts/climate-data/fetch-daymet.ts",
    "climate:data:generate": "tsx scripts/climate-data/generate.ts",
    "climate:data:verify": "tsx scripts/climate-data/verify.ts",
    "climate:data:audit": "tsx scripts/climate-data/audit.ts",
    "climate:data:update": "tsx scripts/climate-data/update.ts",
    "corpus:research:bootstrap": "tsx scripts/research/bootstrap-research-layer.ts",
    "corpus:research:citations": "tsx scripts/research/build-citations-overlay.ts",
    "corpus:research:verify": "tsx scripts/research/verify-research.ts",
    "corpus:voice:check": "tsx scripts/research/voice-check.ts",
    "corpus:consistency:check": "tsx scripts/research/consistency-check.ts",
    "corpus:links:check": "tsx scripts/research/links-check.ts",
    "corpus:research:report": "tsx scripts/research/research-report.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.12.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
